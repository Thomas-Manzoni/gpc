// NBA 2K27 - Rhythm Shooting (Xbox) - v7
// Cronus Zen / GPC Studio
//
// Rhythm shooting = pull the RIGHT STICK DOWN, hold, then flick it
// quickly UP. This script does the whole motion for you.
//
// Triggers (both fire immediately on press):
//   SHOT BUTTON (default XB1_PR2, rebindable on menu page 9)
//                            -> shot, uses TOTAL_TIME_MP (DRIBBLE on OLED).
//                               A new rumble during the hold-down adds
//                               RUMBLE_HOLD_BONUS ms to the hold time.
//   XB1_PL2 (left paddle 2)  -> catch shot, uses CATCH_TIME_MP
//   XB1_PL1 (left paddle 1)  -> with left stick past X_HOLD_STICK_MIN %,
//                               holds X for X_HOLD_TIME ms
//
// INTENSE D (new in v7):
//   Double press D-Pad UP (outside of the menus / tuning combos) toggles
//   Intense D. While on, LT is blinked 0 / 100 every INTENSE_D_PHASE_MS ms.
//   "INT D" shows on the main OLED page while it is active.
//   Double press D-Pad UP again to turn it off.
//
// REBIND SHOT BUTTON (new in v7, menu page 9):
//   Open the menu (hold LB + RB), go to page 9 (SHOT BUTTON). It shows the
//   button that currently fires the shot. Hold D-Pad UP and press another
//   button to make that button the new shot trigger. Allowed buttons:
//   A, B, X, Y, LS, RS, PR1, PR2. (PL1 / PL2 are not allowed, they are used
//   by the X-hold action and the catch shot.) The choice is saved to flash.
//   While on this page the allowed buttons are not sent to the game.
//
// MANUAL PRESS (menu page 8, off by default):
//   X pressed with the left stick under MANUAL_STICK_MAX % and RT released
//   -> the X press is swallowed and the stick is pulled DOWN for as long as
//      the button is held. Releasing X runs the normal rise + up-hold, so the
//      hold time is driven by your button instead of TOTAL_TIME_MP.
//      Latency, when on, keeps the stick down for LATENCY VALUE ms after the
//      release, exactly like it extends the automatic hold.
//   X with RT held, or with the left stick pushed, passes straight through.
//
// Rumble and snatch-back detection still run in the background
// (time_since_rumble / time_since_snatch) for future use, but nothing
// waits on them.
//
// Menu (hold LB + RB): D-Pad LEFT / RIGHT = previous / next page,
//                      D-Pad DOWN / UP    = value -3 / +3 (toggle: OFF / ON)
//   Page 1: DRIBBLE SHOT timing (TOTAL_TIME_MP)
//   Page 2: CATCH AND SHOOT timing (CATCH_TIME_MP)
//   Page 3: INFINITE STAMINA OFF / ON (left stick reduced by 70%, same direction)
//   Page 4: LATENCY OFF / ON
//   Page 5: LATENCY VALUE (also quick access via LT + RB)
//   Page 6: RISE TIME (RISE_TIME_MP)
//   Page 7: RANDOM ANGLE OFF / ON (random X path + X noise, off by default)
//   Page 8: MANUAL PRESS OFF / ON (X button drives the hold-down time)
//   Page 9: SHOT BUTTON (hold D-Pad UP + a button to rebind)
//
// Live tuning (auto-saved, Latency resets on script reload):
//   LT + RT + D-Pad LEFT / RIGHT -> TOTAL_TIME_MP (DRIBBLE)  -3 / +3
//   LT + RT + D-Pad DOWN / UP    -> RISE_TIME_MP              -3 / +3
//   LT + RT + X / B              -> CATCH_TIME_MP             -3 / +3
//   LT + RB + D-Pad LEFT / RIGHT -> LATENCY VALUE             -3 / +3
//   LT + RB + D-Pad DOWN / UP    -> LATENCY TOGGLE            OFF / ON

define CATCH_BTN = XB1_PL2; // left paddle 2 (catch shot)
define TRIGGER_DEFAULT = XB1_PR2; // default shot button (rebindable on menu page 9)
define RX        = XB1_RX;
define RY        = XB1_RY;
define LT_BUTTON = XB1_LT;
define RT_BUTTON = XB1_RT;
define LB_BUTTON = XB1_LB;
define RB_BUTTON = XB1_RB;

define TRIGGER_THRESHOLD = 50; // LT/RT are analog, 0-100

define SHOT_STATIC = 0;

define TOTAL_TIME_MIN     = 100;
define TOTAL_TIME_MAX     = 2000;
define TOTAL_TIME_DEFAULT = 567;

define CATCH_TIME_MIN     = 100;
define CATCH_TIME_MAX     = 2000;
define CATCH_TIME_DEFAULT = 523;

define RISE_TIME_MIN     = 5;   // keeps the ramp maths inside 16-bit
define RISE_TIME_MAX     = 300;
define RISE_TIME_DEFAULT = 114;

define RUMBLE_TIME_CAP         = 5000; // cap the background counters, avoid overflow
define RUMBLE_DETECT_THRESHOLD = 1;    // any motor value >= this counts as "rumbling"

define SAVE_DELAY = 400; // ms of no changes before writing to flash

// Right stick Y: +100 = down, -100 = up
define STICK_DOWN = 100;
define STICK_UP   = -100;

// Snatch back detection (RT + RS pointing down), unused by the shot for now
define SNATCH_RY = 93;
int time_since_snatch = RUMBLE_TIME_CAP;
int snatch_prev = 0;

define IDLE        = 0;
define HOLD_DOWN   = 1;
define PULL_UP     = 2;
define HOLD_UP     = 3;
define HOLD_MANUAL = 4; // stick down, waiting for the X button to be released

define UP_HOLD_TIME = 100; // ms the stick stays at full up before release

define X_NOISE = 2; // RX jitter during the shot, +/- this value (0 = perfectly straight)
define X_PATH_MAX = 15; // random RX at the bottom and at the top of the pull, +/- this value (0 = vertical)

define RUMBLE_HOLD_BONUS = 0; // ms added to the hold-down time per new rumble during the hold
define NOTIFY_RUMBLE_MS  = 100; // length of each of the two notification rumbles (and the gap)
define NOTIFY_RUMBLE_PWR = 50; // notification rumble intensity, 0-100

define X_HOLD_TIME      = 250; // ms the X button is held by the PL1 action
define X_HOLD_STICK_MIN = 70;  // left stick modulus (%) needed for the PL1 action

define MANUAL_HOLD      = -1; // start_shot() argument: hold until X is released
define MANUAL_STICK_MAX = 30; // left stick modulus (%) still counted as "no input"

define STAMINA_SCALE = 70; // % of the left stick kept when INFINITE STAMINA is on

define DOUBLE_PRESS_MS    = 300; // max gap between the two D-Pad UP presses
define INTENSE_D_PHASE_MS = 50;  // ms LT stays at 0, then at 100 (full blink cycle = 2x this)

define MENU_PAGE_DRIBBLE = 0;
define MENU_PAGE_CATCH   = 1;
define MENU_PAGE_STAMINA = 2;
define MENU_PAGE_LATENCY_ON  = 3;
define MENU_PAGE_LATENCY_VAL = 4;
define MENU_PAGE_RISE        = 5;
define MENU_PAGE_ANGLE       = 6;
define MENU_PAGE_MANUAL      = 7;
define MENU_PAGE_SHOTBTN     = 8;
define MENU_PAGE_LAST        = 8;

int profile = SHOT_STATIC;
int TOTAL_TIME_MP;
int CATCH_TIME_MP;
int RISE_TIME_MP;
int trigger_btn = TRIGGER_DEFAULT; // button that fires the main shot (loaded from flash in init)
int state = IDLE;
int timer = 0;
int hold_time = 0;
int rise = 0;
int value = 0;
int x_start = 0;
int x_end = 0;
int y_start = 0;
int y_end = 0;
int x_val = 0;
int adjusting_timing = 0;
int rumble_prev = 0;
int rumble_new = 0;
int bonus_hit = 0;
int notify_timer = 0;
int x_hold_timer = 0;

int adjusting_latency = 0;
int dirty = 0;
int save_timer = 0;
int saved_timer = 0;
int digits = 0;
int nlen = 0;
int rumble_now = 0;
int snatch_back = 0;
int time_since_rumble = RUMBLE_TIME_CAP;

int latency_val = 55;
int latency_on = 1; // 0 = off, 1 = on

int menu_active = 0;
int menu_page = 0;
int infinite_stamina = 0;
int angle_random = 0;     // 1 = random pull path + X noise, 0 = straight vertical (no X noise)
int manual_press = 0;     // 1 = X button drives the hold-down time

int x_btn = 0;       // real X input, sampled before any set_val of this iteration
int x_btn_prev = 0;
int x_btn_press = 0;
int manual_shot = 0; // the running shot was started by the X button

int up_held = 0;         // real D-Pad UP input, sampled before any set_val of this iteration
int dup_timer = 0;       // > 0 while waiting for the second D-Pad UP press
int intense_d = 0;       // 1 = Intense D active (LT blinking)
int intense_phase = 0;   // current blink phase: 0 = LT low, 1 = LT high
int intense_timer = 0;

function print_num(num, x, y) {
    digits = 0;
    if(num >= 1000) {
        digits = digits + 1;
        putc_oled(digits, ASCII_DIGIT0 + ((num / 1000) % 10));
    }
    if(num >= 100) {
        digits = digits + 1;
        putc_oled(digits, ASCII_DIGIT0 + ((num / 100) % 10));
    }
    if(num >= 10) {
        digits = digits + 1;
        putc_oled(digits, ASCII_DIGIT0 + ((num / 10) % 10));
    }
    digits = digits + 1;
    putc_oled(digits, ASCII_DIGIT0 + (num % 10));
    puts_oled(x, y, OLED_FONT_MEDIUM, digits, OLED_WHITE);
}

// Prints the name of a button (A, B, X, Y, LS, RS, PR1, PR2, PL1, PL2) on the OLED.
// Falls back to the raw button number for anything else.
function print_btn_name(b, x, y) {
    nlen = 0;
    if(b == XB1_PR1 || b == XB1_PR2 || b == XB1_PL1 || b == XB1_PL2) {
        nlen = 3;
        putc_oled(1, ASCII_UPPER_P);
        if(b == XB1_PR1 || b == XB1_PR2) {
            putc_oled(2, ASCII_UPPER_R);
        } else {
            putc_oled(2, ASCII_UPPER_L);
        }
        if(b == XB1_PR1 || b == XB1_PL1) {
            putc_oled(3, ASCII_DIGIT0 + 1);
        } else {
            putc_oled(3, ASCII_DIGIT0 + 2);
        }
    } else if(b == XB1_LS || b == XB1_RS) {
        nlen = 2;
        if(b == XB1_LS) {
            putc_oled(1, ASCII_UPPER_L);
        } else {
            putc_oled(1, ASCII_UPPER_R);
        }
        putc_oled(2, ASCII_UPPER_S);
    } else if(b == XB1_A) {
        nlen = 1;
        putc_oled(1, ASCII_UPPER_A);
    } else if(b == XB1_B) {
        nlen = 1;
        putc_oled(1, ASCII_UPPER_B);
    } else if(b == XB1_X) {
        nlen = 1;
        putc_oled(1, ASCII_UPPER_X);
    } else if(b == XB1_Y) {
        nlen = 1;
        putc_oled(1, ASCII_UPPER_Y);
    }

    if(nlen > 0) {
        puts_oled(x, y, OLED_FONT_MEDIUM, nlen, OLED_WHITE);
    } else {
        print_num(b, x, y);
    }
}

// Shot-button rebind: with D-Pad UP held, a fresh press of b becomes the shot trigger.
// The button is swallowed so it never reaches the game while on the SHOT BUTTON page.
function try_assign(b) {
    if(up_held && event_press(b)) {
        trigger_btn = b;
        dirty       = 1;
        save_timer  = SAVE_DELAY;
    }
    set_val(b, 0);
}

// Starts the stick motion. ht = hold-down ms, or MANUAL_HOLD to hold until the
// X button is released.
function start_shot(ht) {
    rise      = RISE_TIME_MP;
    timer     = 0;
    bonus_hit = 0;
    if(ht < 0) {
        hold_time   = 0;
        state       = HOLD_MANUAL;
        manual_shot = 1;
    } else {
        hold_time = ht;
        if(latency_on) { hold_time = hold_time + latency_val; }
        state       = HOLD_DOWN;
        manual_shot = 0;
    }
    x_start   = 0;
    x_end     = 0;
    if(angle_random) {
        x_start = random(0, X_PATH_MAX * 2) - X_PATH_MAX;
        x_end   = random(0, X_PATH_MAX * 2) - X_PATH_MAX;
    }
    // keep the endpoints on the radius-100 circle: y ~= 100 - x^2/200 (no sqrt in GPC)
    y_start   = STICK_DOWN - ((x_start * x_start) / 200);
    y_end     = STICK_UP + ((x_end * x_end) / 200);
}

init {
    // SPVAR_7..10 so this script doesn't share saved values with the original (SPVAR_2..6)
    TOTAL_TIME_MP = get_pvar(SPVAR_7, TOTAL_TIME_MIN, TOTAL_TIME_MAX, TOTAL_TIME_DEFAULT);
    RISE_TIME_MP  = get_pvar(SPVAR_8, RISE_TIME_MIN,  RISE_TIME_MAX,  RISE_TIME_DEFAULT);
    CATCH_TIME_MP = get_pvar(SPVAR_9, CATCH_TIME_MIN, CATCH_TIME_MAX, CATCH_TIME_DEFAULT);
    trigger_btn   = get_pvar(SPVAR_10, 1, 100, TRIGGER_DEFAULT);
}

main {

    // ---- X button edge, read before anything can overwrite the output ----
    x_btn       = get_val(XB1_X) > 0;
    x_btn_press = x_btn && !x_btn_prev;
    x_btn_prev  = x_btn;

    // real D-Pad UP state (used by the shot-button rebind, before the menu zeroes it)
    up_held = get_val(XB1_UP) > 0;

    // ---- background rumble tracking (always runs) ----
    rumble_now = get_rumble(RUMBLE_A) >= RUMBLE_DETECT_THRESHOLD || get_rumble(RUMBLE_B) >= RUMBLE_DETECT_THRESHOLD;
    if(rumble_now) {
        time_since_rumble = 0;
    } else if(time_since_rumble < RUMBLE_TIME_CAP) {
        time_since_rumble = time_since_rumble + get_rtime();
    }
    // rising edge = a new rumble pulse; used by the hold-down extension
    rumble_new  = rumble_now && !rumble_prev;
    rumble_prev = rumble_now;

    // ---- background snatch tracking (always runs) ----
    snatch_back = (get_val(XB1_RY) > SNATCH_RY) && (get_val(XB1_RT) > 50);
    if(snatch_back && !snatch_prev) {
        time_since_snatch = 0;
    } else if(time_since_snatch < RUMBLE_TIME_CAP) {
        time_since_snatch = time_since_snatch + get_rtime();
    }
    snatch_prev = snatch_back;

    // ---- live tuning: rhythm timing (LT+RT) ----
    adjusting_timing = get_val(LT_BUTTON) > TRIGGER_THRESHOLD && get_val(RT_BUTTON) > TRIGGER_THRESHOLD;

    if(adjusting_timing) {
        if(event_press(XB1_RIGHT) && TOTAL_TIME_MP < TOTAL_TIME_MAX) {
            TOTAL_TIME_MP = TOTAL_TIME_MP + 3;
            if(TOTAL_TIME_MP > TOTAL_TIME_MAX) { TOTAL_TIME_MP = TOTAL_TIME_MAX; }
            dirty         = 1;
            save_timer    = SAVE_DELAY;
        }
        if(event_press(XB1_LEFT) && TOTAL_TIME_MP > TOTAL_TIME_MIN) {
            TOTAL_TIME_MP = TOTAL_TIME_MP - 3;
            if(TOTAL_TIME_MP < TOTAL_TIME_MIN) { TOTAL_TIME_MP = TOTAL_TIME_MIN; }
            dirty         = 1;
            save_timer    = SAVE_DELAY;
        }
        if(event_press(XB1_UP) && RISE_TIME_MP < RISE_TIME_MAX) {
            RISE_TIME_MP = RISE_TIME_MP + 3;
            if(RISE_TIME_MP > RISE_TIME_MAX) { RISE_TIME_MP = RISE_TIME_MAX; }
            dirty        = 1;
            save_timer   = SAVE_DELAY;
        }
        if(event_press(XB1_DOWN) && RISE_TIME_MP > RISE_TIME_MIN) {
            RISE_TIME_MP = RISE_TIME_MP - 3;
            if(RISE_TIME_MP < RISE_TIME_MIN) { RISE_TIME_MP = RISE_TIME_MIN; }
            dirty        = 1;
            save_timer   = SAVE_DELAY;
        }
        // catch timing: B = plus, X = minus
        if(event_press(XB1_B) && CATCH_TIME_MP < CATCH_TIME_MAX) {
            CATCH_TIME_MP = CATCH_TIME_MP + 3;
            if(CATCH_TIME_MP > CATCH_TIME_MAX) { CATCH_TIME_MP = CATCH_TIME_MAX; }
            dirty         = 1;
            save_timer    = SAVE_DELAY;
        }
        if(event_press(XB1_X) && CATCH_TIME_MP > CATCH_TIME_MIN) {
            CATCH_TIME_MP = CATCH_TIME_MP - 3;
            if(CATCH_TIME_MP < CATCH_TIME_MIN) { CATCH_TIME_MP = CATCH_TIME_MIN; }
            dirty         = 1;
            save_timer    = SAVE_DELAY;
        }

        // don't let the tuning combo leak inputs into the game
        set_val(LT_BUTTON, 0);
        set_val(RT_BUTTON, 0);
        set_val(XB1_UP, 0);
        set_val(XB1_DOWN, 0);
        set_val(XB1_LEFT, 0);
        set_val(XB1_RIGHT, 0);
        set_val(XB1_B, 0);
        set_val(XB1_X, 0);
    }

    // ---- live tuning: latency config (LT+RB) ----
    adjusting_latency = get_val(LT_BUTTON) > TRIGGER_THRESHOLD && get_val(RB_BUTTON) > 0;

    if(adjusting_latency) {
        if(event_press(XB1_RIGHT)) {
            latency_val = latency_val + 3;
        }
        if(event_press(XB1_LEFT)) {
            if(latency_val > 0) {
                latency_val = latency_val - 3;
                if(latency_val < 0) { latency_val = 0; }
            }
        }
        if(event_press(XB1_UP)) {
            latency_on = 1;
        }
        if(event_press(XB1_DOWN)) {
            latency_on = 0;
        }

        set_val(LT_BUTTON, 0);
        set_val(RB_BUTTON, 0);
        set_val(XB1_UP, 0);
        set_val(XB1_DOWN, 0);
        set_val(XB1_LEFT, 0);
        set_val(XB1_RIGHT, 0);
    }

    // ---- menu (LB+RB): left/right = page, up/down = value ----
    menu_active = get_val(LB_BUTTON) > 0 && get_val(RB_BUTTON) > 0 && get_val(LT_BUTTON) <= TRIGGER_THRESHOLD;

    if(menu_active) {
        if(event_press(XB1_RIGHT) && menu_page < MENU_PAGE_LAST) {
            menu_page = menu_page + 1;
        }
        if(event_press(XB1_LEFT) && menu_page > 0) {
            menu_page = menu_page - 1;
        }

        if(menu_page == MENU_PAGE_DRIBBLE) {
            if(event_press(XB1_UP) && TOTAL_TIME_MP < TOTAL_TIME_MAX) {
                TOTAL_TIME_MP = TOTAL_TIME_MP + 3;
                if(TOTAL_TIME_MP > TOTAL_TIME_MAX) { TOTAL_TIME_MP = TOTAL_TIME_MAX; }
                dirty         = 1;
                save_timer    = SAVE_DELAY;
            }
            if(event_press(XB1_DOWN) && TOTAL_TIME_MP > TOTAL_TIME_MIN) {
                TOTAL_TIME_MP = TOTAL_TIME_MP - 3;
                if(TOTAL_TIME_MP < TOTAL_TIME_MIN) { TOTAL_TIME_MP = TOTAL_TIME_MIN; }
                dirty         = 1;
                save_timer    = SAVE_DELAY;
            }
        } else if(menu_page == MENU_PAGE_CATCH) {
            if(event_press(XB1_UP) && CATCH_TIME_MP < CATCH_TIME_MAX) {
                CATCH_TIME_MP = CATCH_TIME_MP + 3;
                if(CATCH_TIME_MP > CATCH_TIME_MAX) { CATCH_TIME_MP = CATCH_TIME_MAX; }
                dirty         = 1;
                save_timer    = SAVE_DELAY;
            }
            if(event_press(XB1_DOWN) && CATCH_TIME_MP > CATCH_TIME_MIN) {
                CATCH_TIME_MP = CATCH_TIME_MP - 3;
                if(CATCH_TIME_MP < CATCH_TIME_MIN) { CATCH_TIME_MP = CATCH_TIME_MIN; }
                dirty         = 1;
                save_timer    = SAVE_DELAY;
            }
        } else if(menu_page == MENU_PAGE_STAMINA) {
            if(event_press(XB1_UP)) {
                infinite_stamina = 1;
            }
            if(event_press(XB1_DOWN)) {
                infinite_stamina = 0;
            }
        } else if(menu_page == MENU_PAGE_LATENCY_ON) {
            if(event_press(XB1_UP)) {
                latency_on = 1;
            }
            if(event_press(XB1_DOWN)) {
                latency_on = 0;
            }
        } else if(menu_page == MENU_PAGE_LATENCY_VAL) {
            if(event_press(XB1_UP)) {
                latency_val = latency_val + 3;
            }
            if(event_press(XB1_DOWN) && latency_val > 0) {
                latency_val = latency_val - 3;
                if(latency_val < 0) { latency_val = 0; }
            }
        } else if(menu_page == MENU_PAGE_RISE) {
            if(event_press(XB1_UP) && RISE_TIME_MP < RISE_TIME_MAX) {
                RISE_TIME_MP = RISE_TIME_MP + 3;
                if(RISE_TIME_MP > RISE_TIME_MAX) { RISE_TIME_MP = RISE_TIME_MAX; }
                dirty        = 1;
                save_timer   = SAVE_DELAY;
            }
            if(event_press(XB1_DOWN) && RISE_TIME_MP > RISE_TIME_MIN) {
                RISE_TIME_MP = RISE_TIME_MP - 3;
                if(RISE_TIME_MP < RISE_TIME_MIN) { RISE_TIME_MP = RISE_TIME_MIN; }
                dirty        = 1;
                save_timer   = SAVE_DELAY;
            }
        } else if(menu_page == MENU_PAGE_ANGLE) {
            if(event_press(XB1_UP)) {
                angle_random = 1;
            }
            if(event_press(XB1_DOWN)) {
                angle_random = 0;
            }
        } else if(menu_page == MENU_PAGE_MANUAL) {
            if(event_press(XB1_UP)) {
                manual_press = 1;
            }
            if(event_press(XB1_DOWN)) {
                manual_press = 0;
            }
        } else {
            // SHOT BUTTON page: hold D-Pad UP + press a button to rebind the shot trigger
            try_assign(XB1_A);
            try_assign(XB1_B);
            try_assign(XB1_X);
            try_assign(XB1_Y);
            try_assign(XB1_LS);
            try_assign(XB1_RS);
            try_assign(XB1_PR1);
            try_assign(XB1_PR2);
        }

        set_val(LB_BUTTON, 0);
        set_val(RB_BUTTON, 0);
        set_val(XB1_UP, 0);
        set_val(XB1_DOWN, 0);
        set_val(XB1_LEFT, 0);
        set_val(XB1_RIGHT, 0);
    }

    // ---- Intense D: double press D-Pad UP toggles it ----
    // not counted while a menu / tuning combo owns the D-Pad
    if(dup_timer > 0) {
        dup_timer = dup_timer - get_rtime();
        if(dup_timer < 0) { dup_timer = 0; }
    }
    if(!menu_active && !adjusting_timing && !adjusting_latency && event_press(XB1_UP)) {
        if(dup_timer > 0) {
            if(intense_d) {
                intense_d = 0;
            } else {
                intense_d = 1;
            }
            dup_timer     = 0;
            intense_phase = 0;
            intense_timer = 0;
        } else {
            dup_timer = DOUBLE_PRESS_MS;
        }
    }

    // debounced write so holding a direction doesn't hammer the flash
    if(dirty) {
        save_timer = save_timer - get_rtime();
        if(save_timer <= 0) {
            set_pvar(SPVAR_7, TOTAL_TIME_MP);
            set_pvar(SPVAR_8, RISE_TIME_MP);
            set_pvar(SPVAR_9, CATCH_TIME_MP);
            set_pvar(SPVAR_10, trigger_btn);
            dirty       = 0;
            saved_timer = 800;
        }
    }

    if(saved_timer > 0) {
        saved_timer = saved_timer - get_rtime();
        if(saved_timer < 0) { saved_timer = 0; }
    }

    // ---- shot trigger: fires immediately on press ----
    if(state == IDLE) {
        if(!adjusting_timing && !adjusting_latency && !menu_active) {
            if(event_press(CATCH_BTN)) {
                start_shot(CATCH_TIME_MP);
            } else if(event_press(trigger_btn)) {
                start_shot(TOTAL_TIME_MP);
            } else if(manual_press && x_btn_press
                      && get_val(RT_BUTTON) <= TRIGGER_THRESHOLD
                      && (get_val(XB1_LX) * get_val(XB1_LX)) + (get_val(XB1_LY) * get_val(XB1_LY)) <= MANUAL_STICK_MAX * MANUAL_STICK_MAX) {
                // squared compare avoids sqrt; left stick read before the stamina scaling
                start_shot(MANUAL_HOLD);
            }
        }
    }

    if(state != IDLE) {
        set_val(trigger_btn, 0);   // don't send the shot-button press to the game
        set_val(CATCH_BTN, 0);
    }

    // ---- PL1 + left stick past threshold: hold X ----
    // squared compare avoids sqrt; max 100^2 + 100^2 still fits 16-bit
    if(!adjusting_timing && event_press(XB1_PL1)
       && (get_val(XB1_LX) * get_val(XB1_LX)) + (get_val(XB1_LY) * get_val(XB1_LY)) > X_HOLD_STICK_MIN * X_HOLD_STICK_MIN) {
        x_hold_timer = X_HOLD_TIME;
    }
    if(x_hold_timer > 0) {
        set_val(XB1_X, 100);
        x_hold_timer = x_hold_timer - get_rtime();
    }
    if(get_val(XB1_PL1)) { set_val(XB1_PL1, 0); }

    // the manual shot owns the X button for the whole motion
    if(manual_shot) { set_val(XB1_X, 0); }

    // scaling both axes keeps the direction and cuts the modulus
    if(infinite_stamina) {
        set_val(XB1_LX, (get_val(XB1_LX) * STAMINA_SCALE) / 100);
        set_val(XB1_LY, (get_val(XB1_LY) * STAMINA_SCALE) / 100);
    }

    if(state != IDLE) {
        // X path and noise only; timing is untouched
        timer = timer + get_rtime();

        if(state == HOLD_MANUAL) {
            set_val(RY, y_start);
            x_val = x_start;
            if(!x_btn) {
                // button released: latency trails the hold, as it extends the automatic one
                hold_time = 0;
                if(latency_on) { hold_time = latency_val; }
                timer = 0;
                state = HOLD_DOWN;
            }
        } else if(state == HOLD_DOWN) {
            set_val(RY, y_start);
            x_val = x_start;
            if(rumble_new) {
                hold_time = hold_time + RUMBLE_HOLD_BONUS;
                bonus_hit = 1;
            }
            if(timer >= hold_time) {
                timer = 0;
                state = PULL_UP;
            }
        } else if(state == PULL_UP) {
            if(timer >= rise) {
                set_val(RY, y_end);
                x_val = x_end;
                timer = 0;
                state = HOLD_UP;
            } else {
                // linear ramp from the start point to the end point
                // fraction is 0-100 first to stay inside 16-bit maths
                value = y_start + (((y_end - y_start) * ((timer * 100) / rise)) / 100);
                set_val(RY, value);
                x_val = x_start + (((x_end - x_start) * timer) / rise);
            }
        } else {
            set_val(RY, y_end);
            x_val = x_end;
            if(timer >= UP_HOLD_TIME) {
                timer       = 0;
                state       = IDLE;
                manual_shot = 0;
                if(bonus_hit) {
                    bonus_hit    = 0;
                    notify_timer = 1;
                }
            }
        }
        if(angle_random) {
            set_val(RX, x_val + random(0, X_NOISE * 2) - X_NOISE);
        } else {
            set_val(RX, x_val);
        }
    }

    // ---- Intense D: blink LT 0 / 100 ----
    // applied last, after every LT read of this iteration; skipped while a menu / combo uses LT
    if(intense_d && !menu_active && !adjusting_timing && !adjusting_latency) {
        intense_timer = intense_timer + get_rtime();
        if(intense_timer >= INTENSE_D_PHASE_MS) {
            intense_timer = 0;
            if(intense_phase) {
                intense_phase = 0;
            } else {
                intense_phase = 1;
            }
        }
        if(intense_phase) {
            set_val(LT_BUTTON, 100);
        } else {
            set_val(LT_BUTTON, 0);
        }
    }

    // two quick rumbles: on, gap, on
    if(notify_timer > 0) {
        if(notify_timer < NOTIFY_RUMBLE_MS || (notify_timer >= NOTIFY_RUMBLE_MS * 2 && notify_timer < NOTIFY_RUMBLE_MS * 3)) {
            set_rumble(RUMBLE_A, NOTIFY_RUMBLE_PWR);
            set_rumble(RUMBLE_B, NOTIFY_RUMBLE_PWR);
        } else {
            reset_rumble(); // set_rumble overrides persist until reset
        }
        notify_timer = notify_timer + get_rtime();
        if(notify_timer >= NOTIFY_RUMBLE_MS * 3) {
            notify_timer = 0;
            reset_rumble();
        }
    }

    cls_oled(OLED_BLACK);

    if(profile == SHOT_STATIC) {
        putc_oled(1, ASCII_UPPER_M);
        putc_oled(2, ASCII_UPPER_P);
        putc_oled(3, ASCII_SPACE);
        putc_oled(4, ASCII_UPPER_S);
        putc_oled(5, ASCII_UPPER_H);
        putc_oled(6, ASCII_UPPER_O);
        putc_oled(7, ASCII_UPPER_T);
        puts_oled(2, 0, OLED_FONT_MEDIUM, 7, OLED_WHITE);
    }

    if(menu_active) {
        if(menu_page == MENU_PAGE_DRIBBLE) {
            putc_oled(1, ASCII_UPPER_D);
            putc_oled(2, ASCII_UPPER_R);
            putc_oled(3, ASCII_UPPER_I);
            putc_oled(4, ASCII_UPPER_B);
            putc_oled(5, ASCII_UPPER_B);
            putc_oled(6, ASCII_UPPER_L);
            putc_oled(7, ASCII_UPPER_E);
            putc_oled(8, ASCII_SPACE);
            putc_oled(9, ASCII_UPPER_S);
            putc_oled(10, ASCII_UPPER_H);
            putc_oled(11, ASCII_UPPER_O);
            putc_oled(12, ASCII_UPPER_T);
            puts_oled(2, 22, OLED_FONT_SMALL, 12, OLED_WHITE);
            print_num(TOTAL_TIME_MP, 2, 34);
        } else if(menu_page == MENU_PAGE_CATCH) {
            putc_oled(1, ASCII_UPPER_C);
            putc_oled(2, ASCII_UPPER_A);
            putc_oled(3, ASCII_UPPER_T);
            putc_oled(4, ASCII_UPPER_C);
            putc_oled(5, ASCII_UPPER_H);
            putc_oled(6, ASCII_SPACE);
            putc_oled(7, ASCII_UPPER_A);
            putc_oled(8, ASCII_UPPER_N);
            putc_oled(9, ASCII_UPPER_D);
            putc_oled(10, ASCII_SPACE);
            putc_oled(11, ASCII_UPPER_S);
            putc_oled(12, ASCII_UPPER_H);
            putc_oled(13, ASCII_UPPER_O);
            putc_oled(14, ASCII_UPPER_O);
            putc_oled(15, ASCII_UPPER_T);
            puts_oled(2, 22, OLED_FONT_SMALL, 15, OLED_WHITE);
            print_num(CATCH_TIME_MP, 2, 34);
        } else if(menu_page == MENU_PAGE_LATENCY_ON) {
            putc_oled(1, ASCII_UPPER_L);
            putc_oled(2, ASCII_UPPER_A);
            putc_oled(3, ASCII_UPPER_T);
            putc_oled(4, ASCII_UPPER_E);
            putc_oled(5, ASCII_UPPER_N);
            putc_oled(6, ASCII_UPPER_C);
            putc_oled(7, ASCII_UPPER_Y);
            puts_oled(2, 22, OLED_FONT_SMALL, 7, OLED_WHITE);

            if(latency_on) {
                putc_oled(1, ASCII_UPPER_O);
                putc_oled(2, ASCII_UPPER_N);
                puts_oled(2, 34, OLED_FONT_MEDIUM, 2, OLED_WHITE);
            } else {
                putc_oled(1, ASCII_UPPER_O);
                putc_oled(2, ASCII_UPPER_F);
                putc_oled(3, ASCII_UPPER_F);
                puts_oled(2, 34, OLED_FONT_MEDIUM, 3, OLED_WHITE);
            }
        } else if(menu_page == MENU_PAGE_LATENCY_VAL) {
            putc_oled(1, ASCII_UPPER_L);
            putc_oled(2, ASCII_UPPER_A);
            putc_oled(3, ASCII_UPPER_T);
            putc_oled(4, ASCII_UPPER_E);
            putc_oled(5, ASCII_UPPER_N);
            putc_oled(6, ASCII_UPPER_C);
            putc_oled(7, ASCII_UPPER_Y);
            putc_oled(8, ASCII_SPACE);
            putc_oled(9, ASCII_UPPER_V);
            putc_oled(10, ASCII_UPPER_A);
            putc_oled(11, ASCII_UPPER_L);
            putc_oled(12, ASCII_UPPER_U);
            putc_oled(13, ASCII_UPPER_E);
            puts_oled(2, 22, OLED_FONT_SMALL, 13, OLED_WHITE);
            print_num(latency_val, 2, 34);
        } else if(menu_page == MENU_PAGE_RISE) {
            putc_oled(1, ASCII_UPPER_R);
            putc_oled(2, ASCII_UPPER_I);
            putc_oled(3, ASCII_UPPER_S);
            putc_oled(4, ASCII_UPPER_E);
            putc_oled(5, ASCII_SPACE);
            putc_oled(6, ASCII_UPPER_T);
            putc_oled(7, ASCII_UPPER_I);
            putc_oled(8, ASCII_UPPER_M);
            putc_oled(9, ASCII_UPPER_E);
            puts_oled(2, 22, OLED_FONT_SMALL, 9, OLED_WHITE);
            print_num(RISE_TIME_MP, 2, 34);
        } else if(menu_page == MENU_PAGE_ANGLE) {
            putc_oled(1, ASCII_UPPER_R);
            putc_oled(2, ASCII_UPPER_A);
            putc_oled(3, ASCII_UPPER_N);
            putc_oled(4, ASCII_UPPER_D);
            putc_oled(5, ASCII_UPPER_O);
            putc_oled(6, ASCII_UPPER_M);
            putc_oled(7, ASCII_SPACE);
            putc_oled(8, ASCII_UPPER_A);
            putc_oled(9, ASCII_UPPER_N);
            putc_oled(10, ASCII_UPPER_G);
            putc_oled(11, ASCII_UPPER_L);
            putc_oled(12, ASCII_UPPER_E);
            puts_oled(2, 22, OLED_FONT_SMALL, 12, OLED_WHITE);

            if(angle_random) {
                putc_oled(1, ASCII_UPPER_O);
                putc_oled(2, ASCII_UPPER_N);
                puts_oled(2, 34, OLED_FONT_MEDIUM, 2, OLED_WHITE);
            } else {
                putc_oled(1, ASCII_UPPER_O);
                putc_oled(2, ASCII_UPPER_F);
                putc_oled(3, ASCII_UPPER_F);
                puts_oled(2, 34, OLED_FONT_MEDIUM, 3, OLED_WHITE);
            }
        } else if(menu_page == MENU_PAGE_MANUAL) {
            putc_oled(1, ASCII_UPPER_M);
            putc_oled(2, ASCII_UPPER_A);
            putc_oled(3, ASCII_UPPER_N);
            putc_oled(4, ASCII_UPPER_U);
            putc_oled(5, ASCII_UPPER_A);
            putc_oled(6, ASCII_UPPER_L);
            putc_oled(7, ASCII_SPACE);
            putc_oled(8, ASCII_UPPER_P);
            putc_oled(9, ASCII_UPPER_R);
            putc_oled(10, ASCII_UPPER_E);
            putc_oled(11, ASCII_UPPER_S);
            putc_oled(12, ASCII_UPPER_S);
            puts_oled(2, 22, OLED_FONT_SMALL, 12, OLED_WHITE);

            if(manual_press) {
                putc_oled(1, ASCII_UPPER_O);
                putc_oled(2, ASCII_UPPER_N);
                puts_oled(2, 34, OLED_FONT_MEDIUM, 2, OLED_WHITE);
            } else {
                putc_oled(1, ASCII_UPPER_O);
                putc_oled(2, ASCII_UPPER_F);
                putc_oled(3, ASCII_UPPER_F);
                puts_oled(2, 34, OLED_FONT_MEDIUM, 3, OLED_WHITE);
            }
        } else if(menu_page == MENU_PAGE_SHOTBTN) {
            putc_oled(1, ASCII_UPPER_S);
            putc_oled(2, ASCII_UPPER_H);
            putc_oled(3, ASCII_UPPER_O);
            putc_oled(4, ASCII_UPPER_T);
            putc_oled(5, ASCII_SPACE);
            putc_oled(6, ASCII_UPPER_B);
            putc_oled(7, ASCII_UPPER_U);
            putc_oled(8, ASCII_UPPER_T);
            putc_oled(9, ASCII_UPPER_T);
            putc_oled(10, ASCII_UPPER_O);
            putc_oled(11, ASCII_UPPER_N);
            puts_oled(2, 22, OLED_FONT_SMALL, 11, OLED_WHITE);
            print_btn_name(trigger_btn, 2, 34);
        } else {
            putc_oled(1, ASCII_UPPER_I);
            putc_oled(2, ASCII_UPPER_N);
            putc_oled(3, ASCII_UPPER_F);
            putc_oled(4, ASCII_UPPER_I);
            putc_oled(5, ASCII_UPPER_N);
            putc_oled(6, ASCII_UPPER_I);
            putc_oled(7, ASCII_UPPER_T);
            putc_oled(8, ASCII_UPPER_E);
            putc_oled(9, ASCII_SPACE);
            putc_oled(10, ASCII_UPPER_S);
            putc_oled(11, ASCII_UPPER_T);
            putc_oled(12, ASCII_UPPER_A);
            putc_oled(13, ASCII_UPPER_M);
            putc_oled(14, ASCII_UPPER_I);
            putc_oled(15, ASCII_UPPER_N);
            putc_oled(16, ASCII_UPPER_A);
            puts_oled(2, 22, OLED_FONT_SMALL, 16, OLED_WHITE);

            if(infinite_stamina) {
                putc_oled(1, ASCII_UPPER_O);
                putc_oled(2, ASCII_UPPER_N);
                puts_oled(2, 34, OLED_FONT_MEDIUM, 2, OLED_WHITE);
            } else {
                putc_oled(1, ASCII_UPPER_O);
                putc_oled(2, ASCII_UPPER_F);
                putc_oled(3, ASCII_UPPER_F);
                puts_oled(2, 34, OLED_FONT_MEDIUM, 3, OLED_WHITE);
            }
        }

        // page indicator, e.g. P1
        putc_oled(1, ASCII_UPPER_P);
        putc_oled(2, ASCII_DIGIT0 + menu_page + 1);
        puts_oled(110, 54, OLED_FONT_SMALL, 2, OLED_WHITE);
    } else if(adjusting_latency) {
        putc_oled(1, ASCII_UPPER_L);
        putc_oled(2, ASCII_UPPER_A);
        putc_oled(3, ASCII_UPPER_T);
        puts_oled(2, 22, OLED_FONT_SMALL, 3, OLED_WHITE);

        putc_oled(1, ASCII_UPPER_S);
        putc_oled(2, ASCII_UPPER_T);
        putc_oled(3, ASCII_UPPER_A);
        putc_oled(4, ASCII_UPPER_T);
        puts_oled(76, 22, OLED_FONT_SMALL, 4, OLED_WHITE);

        print_num(latency_val, 2, 34);

        if(latency_on) {
            putc_oled(1, ASCII_UPPER_O);
            putc_oled(2, ASCII_UPPER_N);
            puts_oled(76, 34, OLED_FONT_MEDIUM, 2, OLED_WHITE);
        } else {
            putc_oled(1, ASCII_UPPER_O);
            putc_oled(2, ASCII_UPPER_F);
            putc_oled(3, ASCII_UPPER_F);
            puts_oled(76, 34, OLED_FONT_MEDIUM, 3, OLED_WHITE);
        }
    } else {
        // default: DRIBBLE / CATCH / RISE (three columns)
        putc_oled(1, ASCII_UPPER_D);
        putc_oled(2, ASCII_UPPER_R);
        putc_oled(3, ASCII_UPPER_I);
        putc_oled(4, ASCII_UPPER_B);
        putc_oled(5, ASCII_UPPER_B);
        putc_oled(6, ASCII_UPPER_L);
        putc_oled(7, ASCII_UPPER_E);
        puts_oled(2, 22, OLED_FONT_SMALL, 7, OLED_WHITE);

        putc_oled(1, ASCII_UPPER_C);
        putc_oled(2, ASCII_UPPER_A);
        putc_oled(3, ASCII_UPPER_T);
        putc_oled(4, ASCII_UPPER_C);
        putc_oled(5, ASCII_UPPER_H);
        puts_oled(48, 22, OLED_FONT_SMALL, 5, OLED_WHITE);

        putc_oled(1, ASCII_UPPER_R);
        putc_oled(2, ASCII_UPPER_I);
        putc_oled(3, ASCII_UPPER_S);
        putc_oled(4, ASCII_UPPER_E);
        puts_oled(94, 22, OLED_FONT_SMALL, 4, OLED_WHITE);

        print_num(TOTAL_TIME_MP, 2, 34);
        print_num(CATCH_TIME_MP, 48, 34);
        print_num(RISE_TIME_MP, 94, 34);

        // MAN marker so you can see manual press is armed without opening the menu
        if(manual_press) {
            putc_oled(1, ASCII_UPPER_M);
            putc_oled(2, ASCII_UPPER_A);
            putc_oled(3, ASCII_UPPER_N);
            puts_oled(104, 54, OLED_FONT_SMALL, 3, OLED_WHITE);
        }

        // INT D marker while Intense D is active
        if(intense_d) {
            putc_oled(1, ASCII_UPPER_I);
            putc_oled(2, ASCII_UPPER_N);
            putc_oled(3, ASCII_UPPER_T);
            putc_oled(4, ASCII_SPACE);
            putc_oled(5, ASCII_UPPER_D);
            puts_oled(46, 54, OLED_FONT_SMALL, 5, OLED_WHITE);
        }
    }

    if(saved_timer > 0) {
        putc_oled(1, ASCII_UPPER_S);
        putc_oled(2, ASCII_UPPER_A);
        putc_oled(3, ASCII_UPPER_V);
        putc_oled(4, ASCII_UPPER_E);
        putc_oled(5, ASCII_UPPER_D);
        puts_oled(2, 54, OLED_FONT_SMALL, 5, OLED_WHITE);
    }
}
