// Cronus Zen / GPC Studio - Xbox
//
// Loops forever:
//   1) Press A, wait 2s. Repeat until a controller rumble is detected.
//   2) Once rumble hits: wait 1s.
//   2b) Optional (PRE_HOLD_MODE, hardcoded below): nothing, OR run the
//       maxcmb combo, OR hold left stick right for LS_RIGHT_MS - then continue.
//   3) Hold X for HOLD_X_MS (tune below).
//   4) Wait 2s.
//   5) Press OPTION (Menu button on Xbox pad).
//   6) Wait 1s.
//   7) Press LEFT.
//   8) Wait 1s.
//   9) Press DOWN.
//  10) Wait 1s.
//  11) Press A.
//  12) Wait 1s.
//  13) Press DOWN.
//  14) Wait 1s.
//  15) Press A.
//  -> back to step 1.

define A_BUTTON      = XB1_A;
define X_BUTTON      = XB1_X;
define OPTION_BUTTON = XB1_MENU;   // "Menu" on Xbox = "Options" on PlayStation
define LEFT_BUTTON   = XB1_LEFT;
define DOWN_BUTTON   = XB1_DOWN;

define PRESS_MS   = 60;    // how long a "tap" is held down
define HOLD_X_MS  = 700;   // <-- set how long to hold X here (ms)

// 760 for mid

// What to do between the post-rumble wait and the X hold. Hardcode ONE of:
//   PRE_HOLD_NONE     - nothing extra, go straight to the X hold
//   PRE_HOLD_MAXCMB   - run the maxcmb combo below, then hold X
//   PRE_HOLD_LS_RIGHT - hold left stick right for LS_RIGHT_MS, then hold X
define PRE_HOLD_NONE     = 0;
define PRE_HOLD_MAXCMB   = 1;
define PRE_HOLD_LS_RIGHT = 2;

define PRE_HOLD_MODE = PRE_HOLD_LS_RIGHT; // <-- set this to one of the three above

define LS_RIGHT_MS = 1200; // ms to hold left stick right for PRE_HOLD_LS_RIGHT
define LS_RIGHT_VAL = 100; // XB1_LX value = full right

define A_RETRY_WAIT      = 2000; // wait between A presses while no rumble
define POST_RUMBLE_WAIT  = 1000;
define WAIT_AFTER_X      = 2000;
define WAIT_AFTER_OPTION = 500;
define WAIT_AFTER_LEFT   = 500;
define WAIT_AFTER_DOWN1  = 500;
define WAIT_AFTER_A1     = 500;
define WAIT_AFTER_DOWN2  = 500;
define WAIR_BEFORE_SHOT  = 200;

define RUMBLE_THRESHOLD = 10; // 0-100, tune if false triggers/misses happen

define ST_PRESS_A           = 0;
define ST_WAIT_A_RETRY      = 1;
define ST_POST_RUMBLE_WAIT  = 2;
define ST_RUN_MAXCMB        = 16;
define ST_HOLD_LS_RIGHT     = 17;
define ST_WAIT_AFTER_LS_RG  = 18;
define ST_HOLD_X            = 3;
define ST_WAIT_AFTER_X      = 4;
define ST_PRESS_OPTION      = 5;
define ST_WAIT_AFTER_OPTION = 6;
define ST_PRESS_LEFT        = 7;
define ST_WAIT_AFTER_LEFT   = 8;
define ST_PRESS_DOWN1       = 9;
define ST_WAIT_AFTER_DOWN1  = 10;
define ST_PRESS_A1          = 11;
define ST_WAIT_AFTER_A1     = 12;
define ST_PRESS_DOWN2       = 13;
define ST_WAIT_AFTER_DOWN2  = 14;
define ST_PRESS_A2          = 15;

int state = ST_PRESS_A;
int timer = 0;
int rumbled = 0;

main {
    timer = timer + get_rtime();

    if(state == ST_PRESS_A) {
        set_val(A_BUTTON, 100);
        if(timer >= PRESS_MS) {
            set_val(A_BUTTON, 0);
            timer = 0;
            rumbled = 0;
            state = ST_WAIT_A_RETRY;
        }
    }
    else if(state == ST_WAIT_A_RETRY) {
        // watch for rumble during the whole 2s window
        if(get_rumble(RUMBLE_A) > RUMBLE_THRESHOLD || get_rumble(RUMBLE_B) > RUMBLE_THRESHOLD) {
            rumbled = 1;
        }

        if(timer >= A_RETRY_WAIT) {
            timer = 0;
            if(rumbled) {
                state = ST_POST_RUMBLE_WAIT;
            } else {
                state = ST_PRESS_A; // no rumble yet, press A again
            }
        }
    }
    else if(state == ST_POST_RUMBLE_WAIT) {
        if(timer >= POST_RUMBLE_WAIT) {
            timer = 0;
            if(PRE_HOLD_MODE == PRE_HOLD_MAXCMB) {
                combo_run(maxcmb);
                state = ST_RUN_MAXCMB;
            } else if(PRE_HOLD_MODE == PRE_HOLD_LS_RIGHT) {
                state = ST_HOLD_LS_RIGHT;
            } else {
                state = ST_HOLD_X;
            }
        }
    }
    else if(state == ST_RUN_MAXCMB) {
        // wait for the combo to fully finish before holding X
        if(!combo_running(maxcmb)) {
            timer = 0;
            state = ST_HOLD_X;
        }
    }
    else if(state == ST_HOLD_LS_RIGHT) {
        set_val(XB1_LX, LS_RIGHT_VAL);
        if(timer >= LS_RIGHT_MS) {
            set_val(XB1_LX, 0);
            timer = 0;
            state = ST_WAIT_AFTER_LS_RG;
        }
    }
	else if(state == ST_WAIT_AFTER_LS_RG) {
		if(timer >= WAIR_BEFORE_SHOT) {
            timer = 0;
            state = ST_HOLD_X;
        }
    }
    else if(state == ST_HOLD_X) {
        set_val(X_BUTTON, 100);
        if(timer >= HOLD_X_MS) {
            set_val(X_BUTTON, 0);
            timer = 0;
            state = ST_WAIT_AFTER_X;
        }
    }
    else if(state == ST_WAIT_AFTER_X) {
        if(timer >= WAIT_AFTER_X) {
            timer = 0;
            state = ST_PRESS_OPTION;
        }
    }
    else if(state == ST_PRESS_OPTION) {
        set_val(OPTION_BUTTON, 100);
        if(timer >= PRESS_MS) {
            set_val(OPTION_BUTTON, 0);
            timer = 0;
            state = ST_WAIT_AFTER_OPTION;
        }
    }
    else if(state == ST_WAIT_AFTER_OPTION) {
        if(timer >= WAIT_AFTER_OPTION) {
            timer = 0;
            state = ST_PRESS_LEFT;
        }
    }
    else if(state == ST_PRESS_LEFT) {
        set_val(LEFT_BUTTON, 100);
        if(timer >= PRESS_MS) {
            set_val(LEFT_BUTTON, 0);
            timer = 0;
            state = ST_WAIT_AFTER_LEFT;
        }
    }
    else if(state == ST_WAIT_AFTER_LEFT) {
        if(timer >= WAIT_AFTER_LEFT) {
            timer = 0;
            state = ST_PRESS_DOWN1;
        }
    }
    else if(state == ST_PRESS_DOWN1) {
        set_val(DOWN_BUTTON, 100);
        if(timer >= PRESS_MS) {
            set_val(DOWN_BUTTON, 0);
            timer = 0;
            state = ST_WAIT_AFTER_DOWN1;
        }
    }
    else if(state == ST_WAIT_AFTER_DOWN1) {
        if(timer >= WAIT_AFTER_DOWN1) {
            timer = 0;
            state = ST_PRESS_A1;
        }
    }
    else if(state == ST_PRESS_A1) {
        set_val(A_BUTTON, 100);
        if(timer >= PRESS_MS) {
            set_val(A_BUTTON, 0);
            timer = 0;
            state = ST_WAIT_AFTER_A1;
        }
    }
    else if(state == ST_WAIT_AFTER_A1) {
        if(timer >= WAIT_AFTER_A1) {
            timer = 0;
            state = ST_PRESS_DOWN2;
        }
    }
    else if(state == ST_PRESS_DOWN2) {
        set_val(DOWN_BUTTON, 100);
        if(timer >= PRESS_MS) {
            set_val(DOWN_BUTTON, 0);
            timer = 0;
            state = ST_WAIT_AFTER_DOWN2;
        }
    }
    else if(state == ST_WAIT_AFTER_DOWN2) {
        if(timer >= WAIT_AFTER_DOWN2) {
            timer = 0;
            state = ST_PRESS_A2;
        }
    }
    else if(state == ST_PRESS_A2) {
        set_val(A_BUTTON, 100);
        if(timer >= PRESS_MS) {
            set_val(A_BUTTON, 0);
            timer = 0;
            state = ST_PRESS_A; // loop back to the very start
        }
    }
}

// Optional combo, only runs when PRE_HOLD_MODE is hardcoded to PRE_HOLD_MAXCMB above.
// Fires between the post-rumble wait and the X hold.
combo maxcmb {
	set_val(XB1_RT, 42);
	wait(10);
	set_val(XB1_RT, 84);
	wait(10);
	set_val(XB1_RT, 100);
	wait(480);
	set_val(XB1_RT, 100);
	set_val(XB1_RY, 48);
	wait(10);
	set_val(XB1_RT, 100);
	set_val(XB1_RX, 28);
	set_val(XB1_RY, 91);
	wait(10);
	set_val(XB1_RT, 100);
	set_val(XB1_RX, 28);
	set_val(XB1_RY, 94);
	wait(10);
	set_val(XB1_RT, 100);
	set_val(XB1_RX, 28);
	set_val(XB1_RY, 95);
	wait(20);
	set_val(XB1_RT, 100);
	set_val(XB1_RX, 27);
	set_val(XB1_RY, 65);
	wait(10);
	set_val(XB1_RT, 100);
	set_val(XB1_RX, 0);
	set_val(XB1_RY, -55);
	wait(10);
	set_val(XB1_RT, 100);
	set_val(XB1_RY, -53);
	wait(10);
	set_val(XB1_RT, 100);
	set_val(XB1_RY, 0);
	wait(10);
	set_val(XB1_RT, 100);
	set_val(XB1_RY, 21);
	wait(10);
	set_val(XB1_RT, 100);
	set_val(XB1_RY, 0);
	wait(250);
	set_val(XB1_RT, 51);
	wait(10);
	set_val(XB1_RT, 21);
	wait(10);
	set_val(XB1_RT, 0);
}
